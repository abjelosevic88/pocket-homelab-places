[Unit]
Description=Pocket Places — the places you love and want to try
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-places
Group=pocket-places
ExecStart=/usr/local/bin/pocket-places
Environment=DATA_DIR=/var/lib/pocket-places
Environment=PORT=8080
Environment=BASE_URL=https://places.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-places
PrivateTmp=true

[Install]
WantedBy=multi-user.target
